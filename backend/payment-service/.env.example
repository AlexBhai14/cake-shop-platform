PORT=3007
DATABASE_URL=mysql://payment_user:ChangeMePayment123@localhost:3306/cake_payment_db
SHADOW_DATABASE_URL=mysql://payment_user:ChangeMePayment123@localhost:3306/cake_payment_db_shadow
# Must be IDENTICAL to the auth-service secret
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-32-chars
RABBITMQ_URL=amqp://cake:ChangeMeRabbit123@localhost:5672
RETRY_DELAY_MS=5000
OUTBOX_POLL_MS=1000

# MOCK payment behaviour (simulation only, no real money)
# NONE    = the customer must call POST /payments/orders/:orderId/pay and choose a scenario
# SUCCESS / FAILURE / TIMEOUT = every payment is completed automatically with that outcome
AUTO_PAY_SCENARIO=NONE
# What the mock bank reports later for a TIMEOUT payment: SUCCEEDED or FAILED
TIMEOUT_RESOLVES_TO=SUCCEEDED
# A payment with an unknown result is checked again after this many seconds
RECONCILE_AFTER_SECONDS=30
