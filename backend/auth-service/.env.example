# Copy to .env in this folder. Use the same passwords as the root .env.
PORT=3001
DATABASE_URL=mysql://auth_user:ChangeMeAuth123@localhost:3306/cake_auth_db
SHADOW_DATABASE_URL=mysql://auth_user:ChangeMeAuth123@localhost:3306/cake_auth_db_shadow
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Used only by "npm run seed" to provision the first admin account
ADMIN_EMAIL=admin@cakeshop.local
ADMIN_PASSWORD=ChangeMeAdmin123
