PORT=3006
DATABASE_URL=mysql://order_user:ChangeMeOrder123@localhost:3306/cake_order_db
SHADOW_DATABASE_URL=mysql://order_user:ChangeMeOrder123@localhost:3306/cake_order_db_shadow
# Must be IDENTICAL to the auth-service secret
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-32-chars
RABBITMQ_URL=amqp://cake:ChangeMeRabbit123@localhost:5672
RETRY_DELAY_MS=5000
OUTBOX_POLL_MS=1000
CART_SERVICE_URL=http://localhost:3004
USER_SERVICE_URL=http://localhost:3002
# Earliest delivery = today + MIN_LEAD_DAYS, latest = today + MAX_ADVANCE_DAYS
MIN_LEAD_DAYS=1
MAX_ADVANCE_DAYS=60
# Orders still waiting for payment after this many minutes are cancelled automatically
PAYMENT_TIMEOUT_MINUTES=15
