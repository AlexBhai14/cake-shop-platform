PORT=3000
# Must be IDENTICAL to the auth-service secret
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-32-chars
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPSTREAM_TIMEOUT_MS=8000

AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
CART_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008

# Rate limits: <NAME>_LIMIT requests per <NAME>_WINDOW_SEC seconds.
# Defaults are used when a variable is missing.
RATE_LOGIN_LIMIT=5
RATE_LOGIN_WINDOW_SEC=60
RATE_AUTH_LIMIT=10
RATE_AUTH_WINDOW_SEC=60
RATE_PUBLIC_LIMIT=120
RATE_PUBLIC_WINDOW_SEC=60
RATE_USER_LIMIT=100
RATE_USER_WINDOW_SEC=60
RATE_ADMIN_LIMIT=60
RATE_ADMIN_WINDOW_SEC=60
