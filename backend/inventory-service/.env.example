PORT=3005
DATABASE_URL=mysql://inventory_user:ChangeMeInventory123@localhost:3306/cake_inventory_db
SHADOW_DATABASE_URL=mysql://inventory_user:ChangeMeInventory123@localhost:3306/cake_inventory_db_shadow
# Must be IDENTICAL to the auth-service secret
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-32-chars
# Same user and password as RABBITMQ_USER / RABBITMQ_PASSWORD in the root .env
RABBITMQ_URL=amqp://cake:ChangeMeRabbit123@localhost:5672
RETRY_DELAY_MS=5000
OUTBOX_POLL_MS=1000
# Delivery slots and how many cakes one slot can produce/deliver
SLOTS=10:00-12:00,12:00-14:00,14:00-16:00,16:00-18:00
DEFAULT_SLOT_CAPACITY=10
