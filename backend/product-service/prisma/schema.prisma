generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cakes       Cake[]

  @@map("categories")
}

model Cake {
  id          String        @id @default(uuid()) @db.Char(36)
  categoryId  String        @db.Char(36)
  name        String        @db.VarChar(150)
  slug        String        @unique @db.VarChar(170)
  description String        @db.Text
  imageUrl    String?       @db.VarChar(500)
  // Shop display only: the shop shows a crossed-out price (selling price / (1 - discount)) and "X% OFF".
  // The customer is ALWAYS charged the real variant price, never the crossed-out one.
  discountPercent Int       @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    CakeVariant[]

  @@index([categoryId])
  @@index([isActive])
  @@map("cakes")
}

// One sellable option: flavour + weight + eggless/regular, each with its own price.
model CakeVariant {
  id          String   @id @default(uuid()) @db.Char(36)
  cakeId      String   @db.Char(36)
  flavour     String   @db.VarChar(80)
  weightGrams Int
  eggless     Boolean  @default(false)
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cake        Cake     @relation(fields: [cakeId], references: [id], onDelete: Cascade)

  @@unique([cakeId, flavour, weightGrams, eggless])
  @@index([price])
  @@map("cake_variants")
}
