# Copy to .env (Copy-Item .env.example .env) and change the passwords.
# Use letters and digits only in passwords (special characters break DATABASE_URL).
# NEVER commit .env. Only this example file is committed.

# MySQL
MYSQL_ROOT_PASSWORD=ChangeMeRoot123
AUTH_DB_PASSWORD=ChangeMeAuth123
USER_DB_PASSWORD=ChangeMeUser123
PRODUCT_DB_PASSWORD=ChangeMeProduct123
CART_DB_PASSWORD=ChangeMeCart123
INVENTORY_DB_PASSWORD=ChangeMeInventory123
ORDER_DB_PASSWORD=ChangeMeOrder123
PAYMENT_DB_PASSWORD=ChangeMePayment123
NOTIFICATION_DB_PASSWORD=ChangeMeNotification123

# RabbitMQ
RABBITMQ_USER=cake
RABBITMQ_PASSWORD=ChangeMeRabbit123

# Auth service (used by docker compose)
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Grafana (monitoring dashboards, http://localhost:3030)
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafana123
